<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files><clear /><add value="index.php" /></files>
    </defaultDocument>
    <directoryBrowse enabled="false" />
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="550502400" />
        <hiddenSegments>
          <add segment="src" /><add segment="database" /><add segment="storage" />
          <add segment="tests" /><add segment="bin" /><add segment="config" /><add segment="tools" />
          <add segment="views" /><add segment="vendor" /><add segment=".git" /><add segment="bootstrap.php" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".sqlite" allowed="false" />
          <add fileExtension=".db" allowed="false" />
          <add fileExtension=".key" allowed="false" />
          <add fileExtension=".md" allowed="false" />
          <add fileExtension=".txt" allowed="false" />
          <add fileExtension=".ini" allowed="false" />
          <add fileExtension=".log" allowed="false" />
          <add fileExtension=".bak" allowed="false" />
          <add fileExtension=".php" allowed="true" />
        </fileExtensions>
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="same-origin" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
